{
  "name": "modmixer",
  "productName": "Modmixer",
  "version": "0.10.5",
  "description": "Agent-driven mod creation and diagnostics for RimWorld and beyond",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/dev-start.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "tsx --test \"src/**/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "fetch:ilspycmd": "node scripts/fetch-ilspycmd.mjs",
    "publish:live-mod": "node scripts/publish-live-mod.mjs",
    "fetch:tree-sitter": "node scripts/fetch-tree-sitter-csharp.mjs",
    "fetch:tree-sitter-java": "node scripts/fetch-tree-sitter-java.mjs",
    "fetch:vineflower": "node scripts/fetch-vineflower.mjs",
    "fetch:neoforge-mdk": "node scripts/fetch-neoforge-mdk.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:game-icons": "node scripts/build-game-icons.mjs",
    "lint:externals": "node scripts/check-extra-resources.mjs",
    "postinstall": "patch-package && node scripts/patch-electron-name.mjs && node scripts/fetch-tree-sitter-csharp.mjs && node scripts/fetch-tree-sitter-java.mjs && node scripts/fetch-vineflower.mjs && node scripts/fetch-neoforge-mdk.mjs"
  },
  "keywords": [],
  "author": {
    "name": "lebek",
    "email": "peteralebek@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^3.6.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "41.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "gifenc": "^1.0.3",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@resvg/resvg-wasm": "^2.6.2",
    "@sentry/electron": "^7.12.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@vscode/ripgrep": "^1.15.9",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "fast-xml-parser": "^5.7.2",
    "isomorphic-git": "^1.37.6",
    "posthog-node": "^5.30.8",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.0",
    "steamworks.js": "^0.4.0",
    "tailwind-merge": "^3.5.0",
    "typebox": "1.1.38",
    "update-electron-app": "^3.1.2",
    "web-tree-sitter": "^0.24.5"
  }
}
